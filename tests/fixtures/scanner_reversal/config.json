{
  "film_profile": "fujifilm_provia_100f",
  "print_profile": "kodak_portra_endura",
  "debug": {
    "deactivate_spatial_effects": true,
    "deactivate_stochastic_effects": true
  },
  "camera": {
    "auto_exposure": false,
    "film_format_mm": 35.0,
    "auto_exposure_method": "center_weighted"
